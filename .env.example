# Supabase configuration for Invifty 2.0
# AI Studio automatically provides env variables or user provides them in Secrets.
# Client-side variables start with VITE_
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Server-side Supabase secrets (never exposed to browser)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

